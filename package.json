{
  "name": "gatsby-starter-netlify-cms",
  "description": "Example business website built with Gatsby and Decap CMS (formerly Netlify CMS)",
  "version": "2.0.0",
  "private": true,
  "author": "Austin Green",
  "license": "MIT",
  "keywords": [
    "gatsby",
    "gatsby-starter",
    "decap-cms",
    "netlify"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "gatsby clean",
    "start": "npm run develop",
    "develop": "gatsby clean && gatsby develop",
    "build": "gatsby clean && gatsby build",
    "serve": "gatsby serve",
    "cms": "decap-server",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "bulma": "^0.9.4",
    "decap-cms-app": "^3.18.0",
    "gatsby": "^5.16.1",
    "gatsby-plugin-decap-cms": "^4.0.4",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-netlify": "^5.1.1",
    "gatsby-plugin-purgecss": "^6.2.1",
    "gatsby-plugin-sass": "^6.16.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-remark-copy-linked-files": "^6.16.0",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-remark-relative-images": "^2.0.5",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "graphql": "^16.15.0",
    "lodash": "^4.18.1",
    "prop-types": "^15.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sass": "^1.89.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "babel-jest": "^30.5.2",
    "babel-preset-gatsby": "^3.16.0",
    "decap-server": "^3.11.6",
    "eslint": "^9.39.5",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "js-yaml": "^4.3.2",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "trim": "0.0.3"
  }
}
